# Public runtime mode for the Institution Trust Workspace.
VITE_APP_ENV=development

# Enable only for explicit demo/fixture previews.
VITE_DEMO_MODE=false

# Use the deployed HTTPS API origin outside development.
# Development falls back to http://localhost:8000 only when this is blank.
VITE_API_BASE_URL="https://api.kairoid.com"

# Optional client-side error reporting DSN if supported by the deployment.
VITE_ERROR_REPORTING_DSN=
